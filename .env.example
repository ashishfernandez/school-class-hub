# Supabase configuration (shared database so every visitor sees the same data).
# Copy this file to ".env.local" for local development, and set the same two
# variables in Vercel (Project Settings -> Environment Variables).
#
# Find these under: Supabase Dashboard -> Project Settings -> API
# The anon/public key is safe to expose in frontend code.
#
# If these are left unset, the app automatically falls back to per-browser
# localStorage (data is NOT shared between visitors).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
